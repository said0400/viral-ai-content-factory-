# ─── مطلوب ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── اختياري (لجلب فيديوهات حقيقية من Pexels) ────────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here

# ─── إعدادات الفيديو ─────────────────────────────────────────────────────────
OUTPUT_DIR=./output
TEMP_DIR=./temp
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
DEFAULT_TOPIC=الطموح والنجاح

# ─── محذوف (لم يعد مطلوباً) ──────────────────────────────────────────────────
# GEMINI_API_KEY=...      ← محذوف
# ELEVENLABS_API_KEY=...  ← محذوف
# ELEVENLABS_VOICE_ID=... ← محذوف
