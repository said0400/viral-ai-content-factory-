# ╔═══════════════════════════════════════════════════════════════════╗
# ║                                                                   ║
# ║              🎬 VIRAL AI CONTENT FACTORY v2.0                    ║
# ║                  Environment Configuration                        ║
# ║                                                                   ║
# ╚═══════════════════════════════════════════════════════════════════╝
#
# 📝 INSTRUCTIONS:
#   1. انسخ هذا الملف إلى .env
#      cp .env.example .env
#   2. املأ المفاتيح المطلوبة (المُعلَّمة بـ ⭐ REQUIRED)
#   3. لا ترفع .env إلى Git! (موجود في .gitignore)
#
# 🔗 الحصول على المفاتيح:
#   • Groq:        https://console.groq.com (مجاني)
#   • Gemini:      https://aistudio.google.com (مجاني)
#   • Pexels:      https://www.pexels.com/api (مجاني)
#   • Pixabay:     https://pixabay.com/api/docs (مجاني)
#   • ElevenLabs:  https://elevenlabs.io (مدفوع)
#
# ═══════════════════════════════════════════════════════════════════


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 🤖 AI - Script Generation                                        ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ⭐ REQUIRED: Groq (المحرك الأساسي - مجاني وسريع)
GROQ_API_KEY=

# 🔶 OPTIONAL: Gemini (احتياطي + مطلوب لـ Gemini TTS)
GEMINI_API_KEY=

# المزود المفضل (auto / groq / gemini)
AI_PROVIDER=auto

# تفعيل الـ fallback التلقائي
ENABLE_AI_FALLBACK=true

# تفعيل validation المحتوى
ENABLE_CONTENT_VALIDATION=true
VALIDATION_MIN_SCORE=60


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 🎙️ TTS - Text To Speech                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

# المحرك الأساسي: auto / edge / groq / gemini / elevenlabs
TTS_ENGINE=auto

# أولوية المحركات (مفصولة بفواصل)
TTS_PRIORITY=edge,groq,gemini,elevenlabs

# تفضيلات
PREFER_GEMINI=false
PREFER_ELEVENLABS=false

# ─── Edge TTS (مجاني - افتراضي) ────────────────────────────────────
TTS_VOICE=ar-SA-HamedNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# الأصوات المتاحة:
#   ar-SA-HamedNeural    → ذكر سعودي 🌟 (افتراضي)
#   ar-SA-ZariyahNeural  → أنثى سعودية
#   ar-EG-ShakirNeural   → ذكر مصري
#   ar-EG-SalmaNeural    → أنثى مصرية
#   ar-AE-HamdanNeural   → ذكر إماراتي
#   ar-JO-TaimNeural     → ذكر أردني

# ─── Groq TTS (عربي - canopylabs orpheus) ──────────────────────────
GROQ_TTS_VOICE=fahad
GROQ_TTS_PARALLEL_CHUNKS=3
GROQ_TTS_ENABLE_EDGE_FALLBACK=true

# الأصوات: fahad / sultan / noura / lulwa

# ─── Gemini TTS (Google - 5 أصوات احترافية) ────────────────────────
GEMINI_VOICE=Achird
GEMINI_STYLE=motivational
GEMINI_TEMPERATURE=1.0
GEMINI_MAX_RETRIES=2
GEMINI_PARALLEL_SCENES=3

# الأصوات: Achird / Algenib / Aoede / Charon / Kore
# الـ styles: motivational / educational / story / quote /
#            promo / viral / psychological

# ─── ElevenLabs (مدفوع - أعلى جودة) ────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.5
ELEVENLABS_SPEAKER_BOOST=true


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 🎤 Whisper - Subtitle Generation                                 ║
# ╚═══════════════════════════════════════════════════════════════════╝

USE_WHISPER=true

# Model size: tiny / base / small / medium / large-v3
# tiny=39MB, base=74MB, small=244MB, medium=769MB, large=1.5GB
WHISPER_MODEL=small

# Chunking
WHISPER_MAX_WORDS=4
WHISPER_MAX_DURATION=2.5
WHISPER_CPU_THREADS=4


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 🎬 Video Sources - Stock Footage                                 ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ⭐ REQUIRED للحصول على فيديوهات HD
PEXELS_API_KEY=
PIXABAY_API_KEY=


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 🎵 Music & SFX                                                    ║
# ╚═══════════════════════════════════════════════════════════════════╝

# الموسيقى الخلفية
ENABLE_BACKGROUND_MUSIC=true
MUSIC_VOLUME=0.15
MUSIC_FADE_IN=2
MUSIC_FADE_OUT=2
MUSIC_DIR=engine/assets/music
MUSIC_SOURCE=local

# المؤثرات الصوتية (SFX)
ENABLE_SFX=true
SFX_DIR=engine/assets/sfx
SFX_VOLUME=0.35
MAX_SFX_PER_VIDEO=5


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 🎨 Audio Processing                                              ║
# ╚═══════════════════════════════════════════════════════════════════╝

# الصوت الرئيسي
VOICE_VOLUME=1.0

# Audio FX
VOICE_ECHO_ENABLED=true
LOUDNESS_PRESET=youtube

# Audio Optimizer
AUDIO_SPEED=1.1
REMOVE_SILENCE=true
NORMALIZE_AUDIO=true
ENHANCE_AUDIO=true
SILENCE_THRESHOLD_DB=-35
MIN_SILENCE_DURATION=0.4

# Breathing
BREATHING_ENABLED=true
BREATHING_PRESET=normal


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ ⚙️ Video Settings                                                 ║
# ╚═══════════════════════════════════════════════════════════════════╝

# الأبعاد (YouTube Shorts / TikTok / Reels)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# المدة المستهدفة (30/45/60 ثانية)
VIDEO_TARGET_DURATION=45

# جودة التصدير: draft / medium / high / ultra
VIDEO_QUALITY=high


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ ✨ Effects & Transitions                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

# Toggles
ENABLE_TRANSITIONS=true
ENABLE_EFFECTS=true
ENABLE_SUBTITLES=true
ENABLE_ZOOM_EFFECT=true
ENABLE_FILM_GRAIN=true
ENABLE_VIGNETTE=true
ENABLE_LETTERBOX=true

# Style
GRADE_STYLE=cinematic_warm
SHAKE_PRESET=normal
LETTERBOX_STYLE=cinematic

# Transitions
TRANSITION_DURATION=0.4
TRANSITION_ENERGY=medium
ENABLE_RANDOM_TRANSITIONS=true


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 📝 Subtitles                                                      ║
# ╚═══════════════════════════════════════════════════════════════════╝

# Style: cinematic / modern / highlight / minimal / bold / karaoke
SUBTITLE_STYLE=cinematic

# Font
SUBTITLE_FONT=Cairo
SUBTITLE_SIZE=78

# Word-by-word timing (Karaoke effect)
ENABLE_WORD_TIMINGS=false


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 🎬 Render Settings (Remotion)                                    ║
# ╚═══════════════════════════════════════════════════════════════════╝

# المحرك: true = Remotion / false = FFmpeg
USE_REMOTION=true

# Remotion paths
REMOTION_DIR=remotion
REMOTION_COMPOSITION=ShortsVideo

# Render quality settings
REMOTION_JPEG_QUALITY=90
REMOTION_CRF=19
REMOTION_CONCURRENCY=4
REMOTION_TIMEOUT=60000
REMOTION_LOG_LEVEL=info
REMOTION_HEADLESS=true

# Browser (للـ CI)
REMOTION_CHROMIUM_PATH=


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 📁 Paths                                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

OUTPUT_DIR=output
TEMP_DIR=temp


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 📝 Content Defaults                                              ║
# ╚═══════════════════════════════════════════════════════════════════╝

# الموضوع الافتراضي
DEFAULT_TOPIC=الطموح والنجاح

# اللغة
DEFAULT_LANGUAGE=ar

# نوع المحتوى: motivational / educational / story / quote
CONTENT_TYPE=motivational


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 🚀 Deployment / CI/CD                                            ║
# ╚═══════════════════════════════════════════════════════════════════╝

# GitHub Actions (يُوفّر تلقائياً)
# GITHUB_TOKEN=auto_provided

# Release author
RELEASE_AUTHOR=AI Shorts Generator

# CI mode (يُضبط تلقائياً في GitHub Actions)
# CI=true


# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 🔧 Advanced / Debugging                                          ║
# ╚═══════════════════════════════════════════════════════════════════╝

# مستوى السجلات: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Log file (اختياري)
# LOG_FILE=logs/engine.log

# وضع التصحيح
DEBUG_MODE=false

# Retries
MAX_RETRIES=3

# Caching (تفعيل في كل المحركات)
ENABLE_CACHING=true
