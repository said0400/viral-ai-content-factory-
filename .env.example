# ════════════════════════════════════════════════════════════════
#         🎬 AI Shorts Generator - Configuration
# ════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════
#                  🤖 AI / مفاتيح الذكاء الاصطناعي
# ════════════════════════════════════════════════════════════════

# --- مطلوب: Groq (المحرك الأساسي لتوليد السكربتات - مجاني وسريع) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- اختياري: Gemini (محرك احتياطي للنصوص) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash


# ════════════════════════════════════════════════════════════════
#                  🎙️ الصوت / Text To Speech
# ════════════════════════════════════════════════════════════════

# --- المحرك الأساسي: edge-tts (مجاني - لا يحتاج مفتاح) ---
TTS_ENGINE=edge
TTS_VOICE=ar-SA-HamedNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%

# الأصوات العربية المتاحة في edge-tts:
# ar-SA-HamedNeural    (سعودي - ذكر) 🌟
# ar-SA-ZariyahNeural  (سعودية - أنثى)
# ar-EG-ShakirNeural   (مصري - ذكر)
# ar-EG-SalmaNeural    (مصرية - أنثى)

# --- اختياري: ElevenLabs (محرك احتياطي - جودة أعلى لكن مدفوع) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2


# ════════════════════════════════════════════════════════════════
#                  🎬 مصادر الفيديو والصور
# ════════════════════════════════════════════════════════════════

# --- Pexels (المصدر الأساسي - مجاني) ---
PEXELS_API_KEY=your_pexels_api_key_here

# --- Pixabay (مصدر إضافي - مجاني) ---
PIXABAY_API_KEY=your_pixabay_api_key_here


# ════════════════════════════════════════════════════════════════
#                  🎵 الموسيقى الخلفية
# ════════════════════════════════════════════════════════════════

ENABLE_BACKGROUND_MUSIC=true
MUSIC_VOLUME=0.15
MUSIC_FADE_IN=2
MUSIC_FADE_OUT=2
MUSIC_DIR=assets/music

# مصدر الموسيقى (local / youtube / pixabay)
MUSIC_SOURCE=local


# ════════════════════════════════════════════════════════════════
#                  ⚙️ إعدادات الفيديو (YouTube Shorts)
# ════════════════════════════════════════════════════════════════

# --- الأبعاد (عمودي 9:16) ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# --- المدة (ديناميكية) ---
VIDEO_MIN_DURATION=30
VIDEO_TARGET_DURATION=45
VIDEO_MAX_DURATION=60

# --- جودة الإخراج ---
VIDEO_BITRATE=8M
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
AUDIO_BITRATE=192k
PIXEL_FORMAT=yuv420p


# ════════════════════════════════════════════════════════════════
#                  📝 إعدادات الترجمة (Subtitles)
# ════════════════════════════════════════════════════════════════

ENABLE_SUBTITLES=true
SUBTITLE_FONT=Cairo-Bold
SUBTITLE_FONT_SIZE=70
SUBTITLE_COLOR=white
SUBTITLE_STROKE_COLOR=black
SUBTITLE_STROKE_WIDTH=4
SUBTITLE_POSITION=center


# ════════════════════════════════════════════════════════════════
#                  🎨 التأثيرات والانتقالات
# ════════════════════════════════════════════════════════════════

ENABLE_EFFECTS=true
ENABLE_TRANSITIONS=true
TRANSITION_DURATION=0.5
TRANSITION_TYPE=fade


# ════════════════════════════════════════════════════════════════
#                  📁 المسارات
# ════════════════════════════════════════════════════════════════

OUTPUT_DIR=output
TEMP_DIR=temp
FONTS_DIR=fonts
ASSETS_DIR=assets
LOGS_DIR=logs


# ════════════════════════════════════════════════════════════════
#                  📝 المحتوى الافتراضي
# ════════════════════════════════════════════════════════════════

DEFAULT_TOPIC=الطموح والنجاح
DEFAULT_LANGUAGE=ar
DEFAULT_STYLE=cinematic
DEFAULT_TONE=motivational


# ════════════════════════════════════════════════════════════════
#                  🚀 إعدادات النشر (GitHub Release)
# ════════════════════════════════════════════════════════════════

# يتم توفيره تلقائياً من GitHub Actions - لا تضعه يدوياً
# GITHUB_TOKEN=auto_provided

RELEASE_PREFIX=short
RELEASE_DRAFT=false
RELEASE_PRERELEASE=false


# ════════════════════════════════════════════════════════════════
#                  🐞 التصحيح
# ════════════════════════════════════════════════════════════════

DEBUG=false
LOG_LEVEL=INFO
KEEP_TEMP_FILES=false
