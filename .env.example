# ════════════════════════════════════════════════════════════════
#           🤖 AI / مفاتيح الذكاء الاصطناعي
# ════════════════════════════════════════════════════════════════

# --- مطلوب: Groq (المحرك الأساسي للنصوص - مجاني وسريع) ---
GROQ_API_KEY=your_groq_api_key_here

# --- اختياري: Gemini (احتياطي للنصوص) ---
GEMINI_API_KEY=

# ════════════════════════════════════════════════════════════════
#           🎙️ الصوت / Text To Speech
# ════════════════════════════════════════════════════════════════

# --- المحرك الأساسي: edge-tts (مجاني - لا يحتاج مفتاح) ---
TTS_VOICE=ar-SA-HamedNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# الأصوات المتاحة:
# ar-SA-HamedNeural    → ذكر سعودي 🌟
# ar-SA-ZariyahNeural  → أنثى سعودية
# ar-EG-ShakirNeural   → ذكر مصري
# ar-EG-SalmaNeural    → أنثى مصرية

# --- اختياري: ElevenLabs (احتياطي - جودة أعلى لكن مدفوع) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ════════════════════════════════════════════════════════════════
#           🎬 مصادر الفيديو والصور
# ════════════════════════════════════════════════════════════════

# --- Pexels (مصدر أساسي للفيديوهات) ---
PEXELS_API_KEY=your_pexels_api_key_here

# --- Pixabay (مصدر إضافي للفيديوهات والموسيقى) ---
PIXABAY_API_KEY=your_pixabay_api_key_here

# ════════════════════════════════════════════════════════════════
#           🎵 الموسيقى الخلفية
# ════════════════════════════════════════════════════════════════

ENABLE_BACKGROUND_MUSIC=true
MUSIC_VOLUME=0.15
VOICE_VOLUME=1.0
MUSIC_FADE_IN=2
MUSIC_FADE_OUT=2

# مصدر الموسيقى: pixabay / local / youtube
MUSIC_SOURCE=pixabay

# ════════════════════════════════════════════════════════════════
#           ⚙️ إعدادات الفيديو (YouTube Shorts)
# ════════════════════════════════════════════════════════════════

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# مدة الفيديو الديناميكية (بين 30 و 60 ثانية)
VIDEO_MIN_DURATION=30
VIDEO_MAX_DURATION=60
VIDEO_TARGET_DURATION=45

# جودة التصدير: low / medium / high / ultra
VIDEO_QUALITY=high

# ════════════════════════════════════════════════════════════════
#           ✨ التأثيرات والانتقالات
# ════════════════════════════════════════════════════════════════

ENABLE_TRANSITIONS=true
ENABLE_EFFECTS=true
ENABLE_SUBTITLES=true
ENABLE_ZOOM_EFFECT=true

# نمط الترجمة: modern / classic / cinematic
SUBTITLE_STYLE=cinematic
SUBTITLE_FONT=Cairo-Bold
SUBTITLE_SIZE=70
SUBTITLE_COLOR=white
SUBTITLE_STROKE_COLOR=black
SUBTITLE_STROKE_WIDTH=4

# ════════════════════════════════════════════════════════════════
#           📁 المسارات
# ════════════════════════════════════════════════════════════════

OUTPUT_DIR=output
TEMP_DIR=temp
FONTS_DIR=fonts
ASSETS_DIR=assets
MUSIC_DIR=assets/music

# ════════════════════════════════════════════════════════════════
#           📝 المحتوى الافتراضي
# ════════════════════════════════════════════════════════════════

DEFAULT_TOPIC=الطموح والنجاح
DEFAULT_LANGUAGE=ar
DEFAULT_STYLE=cinematic

# نوع المحتوى: motivational / educational / story / quote
CONTENT_TYPE=motivational

# ════════════════════════════════════════════════════════════════
#           🚀 إعدادات النشر
# ════════════════════════════════════════════════════════════════

# يتم توفيره تلقائياً من GitHub Actions - لا تضعه يدوياً
# GITHUB_TOKEN=auto_provided

# اسم المنشئ في الـ Release
RELEASE_AUTHOR=AI Shorts Generator

# ════════════════════════════════════════════════════════════════
#           🔧 إعدادات متقدمة
# ════════════════════════════════════════════════════════════════

# مستوى السجلات: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# تفعيل وضع التصحيح
DEBUG_MODE=false

# عدد محاولات إعادة المحاولة عند الفشل
MAX_RETRIES=3


# --- ElevenLabs Advanced Settings ---
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.5
ELEVENLABS_SPEAKER_BOOST=true

# --- Breathing Settings ---
BREATHING_ENABLED=true
BREATHING_PRESET=normal

# --- Audio FX Settings ---
LOUDNESS_PRESET=youtube      # youtube/tiktok/instagram/spotify/podcast
VOICE_VOLUME=1.0
VOICE_ECHO_ENABLED=true

# --- Music Engine Settings ---
ENABLE_YOUTUBE_MUSIC=true        # احتياطي - قد يفشل في GitHub Actions
MUSIC_DOWNLOAD_TIMEOUT=60
