{
  "name": "viral-ai-content-factory-remotion",
  "version": "2.0.0",
  "description": "Remotion video renderer for Viral AI Content Factory (Arabic Shorts)",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "studio": "remotion studio",
    "dev": "remotion studio",
    "render": "remotion render src/index.ts ShortsVideo out/video.mp4",
    "render:props": "remotion render src/index.ts ShortsVideo out/video.mp4 --props=props.json",
    "render:draft": "remotion render src/index.ts ShortsVideo out/draft.mp4 --crf=28",
    "render:high": "remotion render src/index.ts ShortsVideo out/video.mp4 --crf=19",
    "render:ultra": "remotion render src/index.ts ShortsVideo out/video.mp4 --crf=17",
    "build": "remotion bundle src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "check": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@remotion/media-utils": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/shapes": "^4.0.0",
    "@remotion/preload": "^4.0.0",
    "@remotion/noise": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "remotion",
    "arabic",
    "video",
    "shorts",
    "tiktok",
    "youtube",
    "ai"
  ],
  "author": "AI Shorts Generator",
  "license": "MIT"
}
